{
  "name": "ieces-media-manager",
  "version": "3.0.8",
  "description": "IECES Media Manager — upload and manage school media for the website",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "release": "vite build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "ph.deped.ieces.news-manager",
    "productName": "IECES Media Manager",
    "copyright": "Copyright © 2026 SDO Isabela City",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main.js",
      "src/preload.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/iecesmediamanager.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/iecesmediamanager.icns"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "buzzjay84",
      "repo": "ieces-news-manager",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "electron-updater": "^6.1.8",
    "mammoth": "^1.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.6",
    "wait-on": "^7.2.0"
  }
}
